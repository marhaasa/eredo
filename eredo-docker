#!/usr/bin/env bash
# Docker Sandboxes twin of eredo, for a like-for-like comparison.
#
# Same commands, same proxy/allowlist.txt, settings.json, plugins.txt and audit
# hook. What differs is underneath: each sandbox is one of Docker's microVMs,
# egress is Docker's host-side TLS-intercepting proxy driven from the allowlist
# (default deny, Docker's own built-in allow rules blocked), and the Claude
# credential never enters the sandbox: run /login once inside, Docker keeps
# the session token on the host. On top of that this script applies the same
# hardening eredo has by construction: passwordless root and the Docker
# socket are taken away from the agent user, .git/hooks and .git/config are
# masked, git identity is taken from the host, permissions prompt again.
#
#   eredo-docker up [--rw] [--no-attach] [claude opts] <primary> [extra-repo ...]
#   eredo-docker attach [name] [claude opts]   (--model M, --effort E, --mode P)
#   eredo-docker shell [name]
#   eredo-docker restart [name]     eredo-docker ps
#   eredo-docker audit [name]       eredo-docker reload
#   eredo-docker clean
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do  # follow symlinks so a link on PATH finds lib.sh
  d="$(cd "$(dirname "$self")" && pwd)"; self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$d/$self" ;; esac
done
HERE="$(cd "$(dirname "$self")" && pwd)"; unset self d
TOOL="eredo-docker"
# shellcheck source=lib.sh
. "$HERE/lib.sh"
# Allow rules Docker bakes into the template's network policy (seen in
# `docker sandbox network log`). A block only beats them in port-qualified
# form. Blocked so the allowlist is the only source of truth.
DOCKER_BUILTIN_ALLOWS=('pypi.org:443' 'files.pythonhosted.org:443' 'ports.ubuntu.com:80' 'download.docker.com:443' '*.docker.com:443')
# Token endpoints /login needs once inside the sandbox. claude.ai itself is
# blocked by a built-in Docker rule; the authorize URL is opened on the host.
LOGIN_HOSTS=(platform.claude.com console.anthropic.com)

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

sb() { printf 'eredo-%s' "$1"; }
ls_sandboxes() { docker sandbox ls 2>/dev/null | awk 'NR>1 && $1 ~ /^eredo-/'; }
status_of()    { ls_sandboxes | awk -v n="$1" '$1==n {print $3}'; }
workspace_of() { ls_sandboxes | awk -v n="$1" '$1==n {$1=$2=$3=""; sub(/^ +/, ""); print}'; }
exists()       { [ -n "$(status_of "$1")" ]; }

X()  { docker sandbox exec "$1" sh -c "$2"; }            # as the agent user
XR() { docker sandbox exec -u root "$1" sh -c "$2"; }    # as root, from outside
XI() { docker sandbox exec -i "$1" sh -c "$2"; }         # with stdin
XRI() { docker sandbox exec -i -u root "$1" sh -c "$2"; }

pick_name() {
  if [ -n "${1:-}" ]; then printf '%s' "$1"; return; fi
  local list; list="$(ls_sandboxes | awk '{print $1}' | sed 's/^eredo-//')"
  [ -n "$list" ] || die "no sandboxes"
  if [ "$(printf '%s\n' "$list" | wc -l | tr -d ' ')" -eq 1 ]; then printf '%s' "$list"
  else need fzf; printf '%s\n' "$list" | fzf --header 'Select sandbox' --height 10 --reverse; fi
}

# Translate the merged allowlist (squid dstdomain lines) into Docker proxy rules.
apply_policy() {  # <sandbox> <primary>
  local sbx="$1" line host
  local list; list="$(allowlist_dir "${sbx#eredo-}" "$2")/allowlist.txt"
  local args=(--policy deny) allowed=" "
  while IFS= read -r line; do
    line="${line%%#*}"; line="$(printf '%s' "$line" | tr -d '[:space:]')"
    [ -z "$line" ] && continue
    case "$line" in
      .*) host="${line#.}"; args+=(--allow-host "$host" --allow-host "*.$host") ;;
      *)  host="$line"; args+=(--allow-host "$host") ;;
    esac
    allowed="$allowed$host "
  done < "$list"
  for host in "${LOGIN_HOSTS[@]}"; do args+=(--allow-host "$host"); done
  # Deny beats allow in Docker's policy, so only block a built-in rule when the
  # allowlist does not name that host.
  for host in "${DOCKER_BUILTIN_ALLOWS[@]}"; do
    case "$allowed" in *" ${host%%:*} "*) ;; *) args+=(--block-host "$host") ;; esac
  done
  docker sandbox network proxy "$sbx" "${args[@]}" >/dev/null
}

# Try to mask .git/hooks and .git/config as eredo does. As of Docker
# sandbox v0.12 this fails: the workspace share refuses mounts even for a
# privileged root exec, so the masks are attempted, never relied upon.
apply_git_masks() {
  local sbx="$1" ws="$2"
  [ -d "$ws/.git" ] || return 0
  if docker sandbox exec --privileged -u root "$sbx" sh -c "
      grep -q ' $ws/.git/hooks ' /proc/mounts || mount -t tmpfs -o ro,size=64k tmpfs '$ws/.git/hooks'
      grep -q ' $ws/.git/config ' /proc/mounts || { mount --bind '$ws/.git/config' '$ws/.git/config' && mount -o remount,bind,ro '$ws/.git/config'; }
    " >/dev/null 2>&1; then
    info "masked $ws/.git/hooks and .git/config"
  else
    info "note: Docker sandbox refuses mounts over the workspace; $ws/.git/hooks and .git/config stay writable (settings deny Edit/Write there, Bash still prompts)"
  fi
}

# One-time and idempotent: hook, settings, identity, privileges, plugins.
prepare() {
  local sbx="$1" primary="$2" rw="$3"; shift 3
  local extras=("$@") e

  XRI "$sbx" 'cat > /usr/local/bin/eredo-audit-hook && chmod 755 /usr/local/bin/eredo-audit-hook' < "$HOOK"
  XRI "$sbx" 'cat > /usr/local/bin/eredo-statusline && chmod 755 /usr/local/bin/eredo-statusline' < "$HERE/sandbox/statusline.sh"
  # Docker's `run` takes no env; the persistent env file it sources does the job.
  X "$sbx" "grep -q '^export CLAUDE_PROJECT_NAME=' /etc/sandbox-persistent.sh 2>/dev/null || echo 'export CLAUDE_PROJECT_NAME=${sbx#eredo-}' >> /etc/sandbox-persistent.sh"
  XI  "$sbx" 'cat > "$HOME/.claude/settings.json"' < "$SETTINGS"

  local gname gemail
  gname="$(git -C "$primary" config --get user.name 2>/dev/null || true)"
  gemail="$(git -C "$primary" config --get user.email 2>/dev/null || true)"
  [ -n "$gname" ]  && X "$sbx" "git config --global user.name '$gname'"
  [ -n "$gemail" ] && X "$sbx" "git config --global user.email '$gemail'"
  git_safe_dirs "$sbx" "$primary" ${extras[@]+"${extras[@]}"}

  # Take passwordless root and the Docker socket away from the agent user.
  XR "$sbx" 'rm -f /etc/sudoers.d/*; gpasswd -d agent sudo >/dev/null 2>&1 || true; gpasswd -d agent docker >/dev/null 2>&1 || true'

  apply_git_masks "$sbx" "$primary"
  if [ "$rw" = 1 ]; then for e in ${extras[@]+"${extras[@]}"}; do apply_git_masks "$sbx" "$e"; done; fi

  if [ -f "$MCP" ]; then
    XI "$sbx" '
      jq -c ".mcpServers // {} | to_entries[]" | while read -r entry; do
        n=$(jq -r .key <<<"$entry"); v=$(jq -c .value <<<"$entry")
        claude mcp remove -s user "$n" >/dev/null 2>&1 || true
        claude mcp add-json -s user "$n" "$v" >/dev/null 2>&1 && echo "mcp: $n" || echo "mcp: failed to add $n" >&2
      done' < "$MCP"
  fi

  if [ -f "$PLUGINS" ]; then
    grep -q '@claude-plugins-official' "$PLUGINS" && X "$sbx" 'claude plugin marketplace add anthropics/claude-plugins-official >/dev/null 2>&1 || true'
    grep -q '@ouroboros' "$PLUGINS" && X "$sbx" 'claude plugin marketplace add Q00/ouroboros >/dev/null 2>&1 || true'
    local plugin out
    while IFS= read -r plugin; do
      case "$plugin" in ''|'#'*) continue ;; esac
      if out="$(docker sandbox exec "$sbx" claude plugin install "$plugin" 2>&1)"; then echo "plugin: $plugin"
      else echo "plugin: $plugin FAILED: $(printf '%s' "$out" | grep -v '^$' | tail -1)" >&2; fi
    done < "$PLUGINS"
  fi

  if [ ${#extras[@]} -gt 0 ]; then
    local mode="read-only"; [ "$rw" = 1 ] && mode="read-write"
    {
      printf '# Multi-repo workspace\n\nPrimary workspace: %s (read-write)\n\nAdditional repos (%s):\n' "$primary" "$mode"
      for e in "${extras[@]}"; do printf -- '- %s\n' "$e"; done
      printf '\nUse absolute paths when referencing files across repos.\n'
    } | XI "$sbx" 'cat > "$HOME/.claude/CLAUDE.md"'
  else
    X "$sbx" 'rm -f "$HOME/.claude/CLAUDE.md"'
  fi
}

cmd_up() {
  parse_claude_opts "$@"; set -- ${REST[@]+"${REST[@]}"}
  local rw=0 attach=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --rw) rw=1; shift ;;
      --no-attach) attach=0; shift ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || die "usage: eredo-docker up [--rw] [--no-attach] <primary> [extra-repo ...]"
  need docker
  local primary; primary="$(cd "$1" 2>/dev/null && pwd -P)" || die "not a directory: $1"; shift
  local extras=() e
  for e in "$@"; do extras+=("$(cd "$e" 2>/dev/null && pwd -P)") || die "not a directory: $e"; done
  local name sbx; name="$(basename "$primary")"; sbx="$(sb "$name")"
  local spec="v1 $primary rw=$rw ${extras[*]-}"

  if exists "$sbx" && [ "$(X "$sbx" 'cat "$HOME/.claude/.eredo-spec" 2>/dev/null')" != "$spec" ]; then
    info "Recreating $sbx (mounts changed)"
    docker sandbox rm "$sbx" >/dev/null
  fi
  if ! exists "$sbx"; then
    local args=("$primary") ro=":ro"; [ $rw -eq 1 ] && ro=""
    for e in ${extras[@]+"${extras[@]}"}; do args+=("$e$ro"); done
    info "Creating Docker sandbox $sbx"
    docker sandbox create --name "$sbx" claude "${args[@]}" >/dev/null
  fi

  apply_policy "$sbx" "$primary"
  prepare "$sbx" "$primary" "$rw" ${extras[@]+"${extras[@]}"}
  X "$sbx" "printf '%s' '$spec' > \"\$HOME/.claude/.eredo-spec\""
  [ $attach -eq 1 ] && cmd_attach "$name"
  return 0
}

cmd_attach() {
  [ $# -gt 0 ] && { parse_claude_opts "$@"; set -- ${REST[@]+"${REST[@]}"}; }
  local name; name="$(pick_name "${1:-}")" || return 0
  local sbx; sbx="$(sb "$name")"
  exists "$sbx" || die "$sbx does not exist (eredo-docker up <dir>)"
  info "First time only: run /login inside. Docker keeps the session token on the host."
  if [ ${#CLAUDE_ARGS[@]} -gt 0 ]; then docker sandbox run "$sbx" -- "${CLAUDE_ARGS[@]}" || true
  else docker sandbox run "$sbx" || true; fi
}

cmd_shell()   { local n; n="$(pick_name "${1:-}")" || return 0; docker sandbox exec -it "$(sb "$n")" bash; }
cmd_ps()      { docker sandbox ls; }
cmd_restart() {
  local n; n="$(pick_name "${1:-}")" || return 0
  local sbx ws; sbx="$(sb "$n")"; ws="$(workspace_of "$sbx")"
  docker sandbox stop "$sbx" >/dev/null && apply_git_masks "$sbx" "$ws" && info "restarted $n"
}
cmd_audit() {
  local n; n="$(pick_name "${1:-}")" || return 0
  local sbx; sbx="$(sb "$n")"
  printf '== egress via Docker proxy (%s) ==\n' "$sbx"
  docker sandbox network log --limit 200 2>/dev/null | awk -v s="$sbx" 'NR==1 || /^(Allowed|Blocked|Denied)/ || $1==s'
  printf '\n== tool calls in %s ==\n' "$sbx"
  X "$sbx" 'cat "$HOME/.claude/audit.log" 2>/dev/null || echo "(none)"'
}
cmd_reload() {
  local s n=0
  for s in $(ls_sandboxes | awk '{print $1}'); do apply_policy "$s" "$(workspace_of "$s")" && n=$((n + 1)); done
  info "reapplied allowlist to $n sandbox(es)"
}
cmd_clean() {
  local s
  for s in $(ls_sandboxes | awk '{print $1}'); do docker sandbox rm "$s" >/dev/null && info "removed $s"; done
}

case "${1:-help}" in
  up)      shift; cmd_up "$@" ;;
  attach)  shift; cmd_attach "$@" ;;
  shell)   shift; cmd_shell "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  ps)      cmd_ps ;;
  audit)   shift; cmd_audit "$@" ;;
  reload)  cmd_reload ;;
  clean)   cmd_clean ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $1 (see eredo-docker help)" ;;
esac
